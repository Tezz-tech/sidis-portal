NODE_ENV=development
PORT=8080

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Single key (back-compat) — or use GEMINI_API_KEYS below for rotation.
GEMINI_API_KEY=
# Comma-separated list of Gemini API keys (e.g. several free-tier accounts).
# Once every model in the fallback chain hits its rate limit on one key, the
# AI client automatically rotates to the next key. Leave blank to use only
# GEMINI_API_KEY above.
GEMINI_API_KEYS=
# Comma-separated override for the model fallback chain (most-capable
# first). Leave blank to use the AI client's built-in default chain.
AI_MODELS=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sidis.app

CLOUDINARY_URL=

# Comma-separate multiple allowed origins if the frontend is deployed at more
# than one URL (e.g. a Vercel production alias plus its preview deployments).
FRONTEND_URL=http://localhost:5173
# Only set this if the frontend and API share a parent domain (e.g. both are
# subdomains of sidis.app) — leave blank when they're on unrelated domains
# (e.g. two separate *.vercel.app subdomains), which is the more common case
# when deployed on Vercel/Render without custom domains.
COOKIE_DOMAIN=

PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
